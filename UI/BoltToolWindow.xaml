<Window x:Class="BoltToolApp.UI.BoltToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BoltToolApp.UI"
        Title="Bolt Tool" Width="1220" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2F6FEB"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1F56C4"/>
        <SolidColorBrush x:Key="Ink" Color="#111827"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Line" Color="#E3E8EF"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD3DF"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- segmented radio buttons -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="White" BorderBrush="#CBD3DF" BorderThickness="1" CornerRadius="6"
                                Padding="10,5" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#2F6FEB"/>
                                <Setter Property="Foreground" Value="#1F56C4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2F6FEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="White" BorderBrush="#CBD3DF" BorderThickness="1" CornerRadius="7" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2F6FEB"/>
                                <Setter TargetName="b" Property="Background" Value="#F5F8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#2F6FEB" CornerRadius="7" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1F56C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="White" BorderBrush="#DCE2EB" BorderThickness="1" CornerRadius="14" Padding="11,4" Margin="0,0,6,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2F6FEB"/>
                                <Setter TargetName="b" Property="Background" Value="#F5F8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- flat tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Padding="14,9" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="c" ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2F6FEB"/>
                                <Setter Property="Foreground" Value="#1F56C4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F56C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="Stat" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- settings -->
        <Border Style="{StaticResource CardBorder}" Grid.Row="0" Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,0">
                    <DockPanel>
                        <ComboBox x:Name="LangBox" DockPanel.Dock="Right" Width="100" Height="26" Padding="6,2" VerticalAlignment="Center" SelectionChanged="OnLanguage">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="日本語"/>
                        </ComboBox>
                        <TextBlock Text="Bolt Tool" FontSize="20" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock x:Name="SubTitle" Text="Bolts · nuts · washers → blocks" Style="{StaticResource Hint}"/>
                </StackPanel>
                <TabControl x:Name="Tabs" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Background="Transparent" Margin="8,8,8,0" Padding="10,0">

                    <!-- PART -->
                    <TabItem Header="Part">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,16">
                                <TextBlock Text="Standard" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="StdIso" Content="ISO" Style="{StaticResource Seg}" GroupName="std" Checked="OnChanged"/>
                                    <RadioButton x:Name="StdJis" Content="JIS" Style="{StaticResource Seg}" GroupName="std" Checked="OnChanged"/>
                                </StackPanel>

                                <TextBlock Text="Part" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="KindBox" SelectionChanged="OnChanged"/>
                                <TextBlock x:Name="DesignationText" Style="{StaticResource Hint}"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Size" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="SizeBox" SelectionChanged="OnSizeChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" x:Name="LengthPanel">
                                        <TextBlock Text="Length L (mm)" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="LengthBox" IsEditable="True" SelectionChanged="OnChanged" LostFocus="OnChanged"/>
                                        <TextBlock x:Name="LengthModeText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <DockPanel x:Name="DefaultPanel" Margin="0,6,0,0">
                                    <Button x:Name="SetDefaultBtn" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="Set as default" Click="OnSetDefault"/>
                                    <TextBlock x:Name="DefaultText" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Insertion / connection point" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="BaseBox" SelectionChanged="OnChanged"/>
                                <TextBlock Text="Block origin 0,0,0 is placed on the axis at this point – snap parts together with it."
                                           Style="{StaticResource Hint}"/>

                                <TextBlock Text="Thread" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThNone" Content="None" Style="{StaticResource Seg}" GroupName="th" Checked="OnChanged"/>
                                    <RadioButton x:Name="ThSimple" Content="Simplified" Style="{StaticResource Seg}" GroupName="th" Checked="OnChanged"/>
                                    <RadioButton x:Name="ThDetail" Content="Detailed (helix)" Style="{StaticResource Seg}" GroupName="th" Checked="OnChanged"/>
                                </StackPanel>

                                <TextBlock Text="Dimensions" Style="{StaticResource Section}"/>
                                <WrapPanel x:Name="DimPanel" Margin="0,6,0,0"/>
                                <TextBlock Text="What the letters mean" Style="{StaticResource Label}"/>
                                <Border Background="#F7F9FC" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <ui:LegendControl x:Name="Legend" Height="180"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ASSEMBLY -->
                    <TabItem Header="Assembly">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,16">
                                <CheckBox x:Name="AsmCheck" Content="Create a bolted connection (bolt + washers + nut)" FontWeight="SemiBold"
                                          Checked="OnChanged" Unchecked="OnChanged" Margin="0,14,0,0"/>
                                <StackPanel x:Name="AsmPanel">
                                    <TextBlock Text="Bolt" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="AsmBoltBox" SelectionChanged="OnAsmBoltChanged"/>

                                    <TextBlock Text="Clamp length – total thickness of the joined parts (mm)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="ClampBox" LostFocus="OnChanged" KeyDown="OnEnterKey"/>

                                    <TextBlock Text="Elements on the bolt" Style="{StaticResource Section}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The list is the real order on the bolt, from the head to the end. T = thickness, Ø = outer diameter, gap = free space in front of the element (all in mm). Type a value to change it; clear the box to go back to the standard."/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="PresetStdBtn" Style="{StaticResource Chip}" Content="Usual set" Tag="std" Click="OnStackPreset"/>
                                        <Button x:Name="PresetDblBtn" Style="{StaticResource Chip}" Content="Double nut" Tag="dbl" Click="OnStackPreset"/>
                                        <Button x:Name="PresetBothBtn" Style="{StaticResource Chip}" Content="Spring both sides" Tag="both" Click="OnStackPreset"/>
                                        <Button x:Name="PresetTapBtn" Style="{StaticResource Chip}" Content="No nut (tapped hole)" Tag="tap" Click="OnStackPreset"/>
                                        <Button x:Name="PresetChanBtn" Style="{StaticResource Chip}" Content="Channel nut set" Tag="chan" Click="OnStackPreset"/>
                                        <Button x:Name="PresetSortBtn" Style="{StaticResource Chip}" Content="Sort to usual order" Tag="sort" Click="OnStackPreset"/>
                                    </WrapPanel>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,4,0,0" Background="#FBFCFE">
                                        <StackPanel x:Name="StackList"/>
                                    </Border>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="AddHeadBox" SelectionChanged="OnAddElement"/>
                                        <ComboBox x:Name="AddNutBox" Grid.Column="2" SelectionChanged="OnAddElement"/>
                                    </Grid>
                                    <Border Background="#F7F9FC" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,10,0,0">
                                        <ui:StackDiagramControl x:Name="StackDiagram1" Height="150"/>
                                    </Border>

                                    <TextBlock Text="Bolt length" Style="{StaticResource Section}"/>
                                    <CheckBox x:Name="AutoLenCheck" Content="Choose standard length automatically" Checked="OnChanged" Unchecked="OnChanged"/>
                                    <TextBlock Text="Thread sticking out beyond the last nut" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ProtrusionBox" Width="60" LostFocus="OnChanged" KeyDown="OnEnterKey"/>
                                        <TextBlock Text="pitches" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="=" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                        <TextBox x:Name="ProtMmBox" Width="60" LostFocus="OnProtMm" KeyDown="OnEnterKey"/>
                                        <TextBlock Text="mm" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Stat}" Margin="0,12,0,0">
                                        <TextBlock x:Name="AsmResult" TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="Blocks" Style="{StaticResource Section}"/>
                                    <CheckBox x:Name="SeparateCheck" Content="Separate block per part (linked set)" Checked="OnChanged" Unchecked="OnChanged"/>
                                    <CheckBox x:Name="StickCheck" Content="Nut side follows the bolt end when the length grip is dragged" Checked="OnChanged" Unchecked="OnChanged"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Each part gets its own block with its connection point at the contact face. In the drawing: drag ▶ on the bolt tip to change only the bolt length; drag ▶ on the first nut-side element to move the whole nut side (clamp length) – the bolt length follows."/>

                                    <TextBlock Text="Part positions" Style="{StaticResource Section}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="In the preview, hold Ctrl and drag a washer or nut to move it along the bolt; it stops when it touches the next element. Pull it further and a green outline shows where it will land – release to swap places. Ctrl+click several parts to move them together. Red numbers are the distances – click one to type an exact value."/>
                                    <Button x:Name="ResetOffsetsBtn" Style="{StaticResource Chip}" Content="Close all gaps" Click="OnResetOffsets" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- VIEW & BLOCK -->
                    <TabItem Header="View &amp; Block">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,16">
                                <TextBlock x:Name="DiagramTitle2" Text="Order and distances on the bolt" Style="{StaticResource Label}"/>
                                <Border x:Name="DiagramBorder2" Background="#F7F9FC" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <ui:StackDiagramControl x:Name="StackDiagram2" Height="150"/>
                                </Border>
                                <TextBlock x:Name="SizesText" Style="{StaticResource Hint}"/>
                                <TextBlock Text="Output" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Out2D" Content="2D view" Style="{StaticResource Seg}" GroupName="out" Checked="OnChanged"/>
                                    <RadioButton x:Name="OutMesh" Content="3D mesh" Style="{StaticResource Seg}" GroupName="out" Checked="OnChanged"/>
                                    <RadioButton x:Name="OutSolid" Content="3D solid" Style="{StaticResource Seg}" GroupName="out" Checked="OnChanged"/>
                                </StackPanel>

                                <TextBlock Text="View direction" Style="{StaticResource Section}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Azimuth °" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Slider x:Name="AzSlider" Grid.Column="1" Minimum="-180" Maximum="180" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="OnSlider"/>
                                    <TextBox x:Name="AzBox" Grid.Column="2" LostFocus="OnAngleBox" KeyDown="OnEnterKey"/>
                                    <TextBlock Grid.Row="1" Text="Elevation °" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Slider x:Name="ElSlider" Grid.Row="1" Grid.Column="1" Minimum="-90" Maximum="90" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="OnSlider"/>
                                    <TextBox x:Name="ElBox" Grid.Row="1" Grid.Column="2" LostFocus="OnAngleBox" KeyDown="OnEnterKey"/>
                                    <TextBlock Grid.Row="2" Text="Hex spin °" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Slider x:Name="SpinSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="60" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="OnSlider"/>
                                    <TextBox x:Name="SpinBox" Grid.Row="2" Grid.Column="2" LostFocus="OnAngleBox" KeyDown="OnEnterKey"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="Hex spin 0° shows the hex across corners, 30° across flats. View presets and angle snapping are in the bar under the preview."/>
                                <CheckBox x:Name="HiddenCheck" Content="Show hidden lines (HIDDEN linetype)" Checked="OnChanged" Unchecked="OnChanged"/>

                                <TextBlock Text="Block" Style="{StaticResource Section}"/>
                                <TextBlock Text="Scale" Style="{StaticResource Label}"/>
                                <DockPanel>
                                    <TextBox x:Name="ScaleBox" Width="70" DockPanel.Dock="Left" LostFocus="OnChanged" KeyDown="OnEnterKey"/>
                                    <WrapPanel Margin="8,4,0,0">
                                        <Button Style="{StaticResource Chip}" Content="0.5" Tag="0.5" Click="OnScaleChip"/>
                                        <Button Style="{StaticResource Chip}" Content="1" Tag="1" Click="OnScaleChip"/>
                                        <Button Style="{StaticResource Chip}" Content="2" Tag="2" Click="OnScaleChip"/>
                                        <Button Style="{StaticResource Chip}" Content="5" Tag="5" Click="OnScaleChip"/>
                                        <Button Style="{StaticResource Chip}" Content="10" Tag="10" Click="OnScaleChip"/>
                                    </WrapPanel>
                                </DockPanel>

                                <CheckBox x:Name="WipeCheck" Content="Add wipeout behind each part" Checked="OnChanged" Unchecked="OnChanged"/>
                                <TextBlock Text="Wipeout layer" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="WipeLayerBox" IsEditable="True" LostFocus="OnChanged" SelectionChanged="OnChanged"/>
                                <TextBlock Style="{StaticResource Hint}" Text="All lines are created on layer 0 with colour / linetype / lineweight ByBlock – only wipeouts go on this layer."/>
                                <CheckBox x:Name="SnapCheck" Content="Length grip snaps to standard lengths" Checked="OnChanged" Unchecked="OnChanged"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TORQUE -->
                    <TabItem Header="Torque">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,16">
                                <TextBlock Text="Calculation method" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="TqMethodBox" SelectionChanged="OnTorqueMethod"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Size" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="TqSizeBox" SelectionChanged="OnTorque"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Property class" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="TqClassBox" SelectionChanged="OnTorque"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Stat}" Margin="0,8,0,0">
                                    <TextBlock x:Name="TqClassInfo" TextWrapping="Wrap" FontSize="12"/>
                                </Border>
                                <TextBlock Text="Bolt / nut surface" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="TqFinishBox" SelectionChanged="OnTorqueMu"/>
                                <TextBlock Text="Lubrication" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="TqLubeBox" SelectionChanged="OnTorqueMu"/>
                                <TextBlock Text="Clamped part material" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="TqMatBox" SelectionChanged="OnTorqueMu"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="μ thread" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TqMuG" LostFocus="OnTorque" KeyDown="OnEnterKey"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="μ head" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TqMuK" LostFocus="OnTorque" KeyDown="OnEnterKey"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Utilisation %" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TqUtil" LostFocus="OnTorque" KeyDown="OnEnterKey"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="TqWasher" Content="Washer under the head / nut" Checked="OnTorque" Unchecked="OnTorque"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <Border Style="{StaticResource Stat}" MinWidth="170">
                                        <StackPanel>
                                            <TextBlock x:Name="TqTorqueLabel" Text="Tightening torque" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TqTorque" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
                                            <TextBlock x:Name="TqRange" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Stat}" MinWidth="150">
                                        <StackPanel>
                                            <TextBlock Text="Preload F_M" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TqPreload" FontSize="24" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TqAs" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="TqPressureBorder" Style="{StaticResource Stat}">
                                    <TextBlock x:Name="TqPressure" TextWrapping="Wrap" FontSize="12"/>
                                </Border>
                                <Border x:Name="TqNoteBorder" Style="{StaticResource Stat}" Background="#FEF3C7" Visibility="Collapsed">
                                    <TextBlock x:Name="TqNote" TextWrapping="Wrap" FontSize="12"/>
                                </Border>

                                <TextBlock Text="All sizes – same conditions" Style="{StaticResource Section}"/>
                                <DataGrid x:Name="TqGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6" BorderBrush="{StaticResource Line}"
                                          RowHeight="24" Margin="0,8,0,0" CanUserResizeRows="False" Background="White" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60"/>
                                        <DataGridTextColumn Header="F_M kN" Binding="{Binding PreloadKN, StringFormat=0.0}" Width="*"/>
                                        <DataGridTextColumn Header="M_A N·m" Binding="{Binding TorqueNm, StringFormat=0.#}" Width="*"/>
                                        <DataGridTextColumn Header="min" Binding="{Binding TorqueMinNm, StringFormat=0.#}" Width="*"/>
                                        <DataGridTextColumn Header="max" Binding="{Binding TorqueMaxNm, StringFormat=0.#}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Torque T = F·(0.16P + 0.58·d2·μG + μK·D_Km/2) = K·d·F. VDI 2230: preload F at the chosen utilisation of the yield point by the combined tension + torsion stress (usually 90 %). JIS B 1083: F = utilisation × yield × stress area (usually 60–70 %). Friction values and surface pressures are typical – use the supplier's data for critical joints. min / max = μ ± 0.02."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- preview -->
        <Border Style="{StaticResource CardBorder}" Grid.Row="0" Grid.Column="2" ClipToBounds="True">
            <DockPanel>
                <!-- view bar: everything that only steers the preview / view direction -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White" Padding="12,8,12,2">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <CheckBox x:Name="ViewSnapCheck" Content="Snap view angles" Margin="14,4,0,0" Checked="OnChanged" Unchecked="OnChanged"/>
                            <CheckBox x:Name="ShowWipeToggle" Content="Show wipeouts" IsChecked="True" Margin="14,4,0,0" Click="OnShowWipe"/>
                            <Button x:Name="FitViewBtn" Style="{StaticResource Chip}" Content="Fit view" Click="OnFitView" Margin="14,0,0,0"/>
                            <Button x:Name="SnapshotBtn" Style="{StaticResource Chip}" Content="Save JPG" Click="OnSnapshot"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Chip}" Content="Side" Tag="0,0" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Head end" Tag="90,0" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Thread end" Tag="-90,0" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Top" Tag="0,90" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Iso SW" Tag="-45,35.264" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Iso SE" Tag="45,35.264" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Iso NE" Tag="135,35.264" Click="OnPreset"/>
                            <Button Style="{StaticResource Chip}" Content="Iso NW" Tag="-135,35.264" Click="OnPreset"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            <Grid>
                <ui:PreviewControl x:Name="Preview"/>
                <TextBox x:Name="DistBox" Visibility="Collapsed" Width="84" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top"
                         BorderBrush="#E11D48" BorderThickness="1.5" FontWeight="SemiBold" KeyDown="OnDistKey" LostFocus="OnDistLost"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,40" Background="#CCFFFFFF" CornerRadius="8" Padding="10,6">
                    <TextBlock x:Name="InfoText" FontSize="12" Foreground="{StaticResource Muted}"/>
                </Border>
            </Grid>
            </DockPanel>
        </Border>

        <!-- actions -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
            <Button x:Name="InsertBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Insert into drawing" Click="OnInsert" Margin="8,0,0,0"/>
            <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Update selected block" Click="OnUpdate" Margin="8,0,0,0" Visibility="Collapsed"/>
            <Button x:Name="MakeBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Create block only" Click="OnMake" Margin="8,0,0,0"/>
            <Button x:Name="ResetBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Reset" Click="OnReset"/>
        </DockPanel>
    </Grid>
</Window>
